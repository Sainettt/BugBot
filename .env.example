# Copy to .env and fill in. Never commit the real .env.
# Every value below is a development default; production values live in the VPS env.

# Postgres container — docker-compose.yml refuses to start without these four.
POSTGRES_USER="bugbot"
POSTGRES_PASSWORD="bugbot"
POSTGRES_DB="bugbot"
# Where the database files live on the host (bind mount), e.g. ./.data/postgres or /srv/bugbot/pg
POSTGRES_DATA="./.data/postgres"
# Host-side port. 5433 by default so a local run does not collide with MAGSpace / MAGGuarantee on 5432.
POSTGRES_HOST_PORT=5433

# Used by pnpm dev / prisma on the host. In the containers compose overrides it with host `postgres`.
DATABASE_URL="postgresql://bugbot:bugbot@localhost:5433/bugbot?schema=public"

# API (host side; inside Docker the container listens on 3001)
API_PORT=3101

# Web (host side; inside Docker the container listens on 3000)
WEB_URL="http://localhost:3100"
# SSR fetches and the /api/* rewrite go here.
API_INTERNAL_URL="http://localhost:3101"

# Signs the OAuth `state` cookie and the `lang` cookie. Required in production; any string in dev.
SESSION_SECRET=""

# Google OAuth for the owner cabinet. Required in production; without them the app boots but
# /auth/google refuses. The redirect URI must match the Google Cloud console exactly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3101/auth/google/callback"

# Owner allowlist — comma-separated e-mails, lower-cased on read. A second owner is an env edit.
ADMIN_EMAILS="danyilfiut@gmail.com"

# Development escape hatch: requests without a session act as this owner (JIT-created if
# missing). Leave empty to require a real Google login. The API refuses to boot with it set
# when NODE_ENV=production.
AUTH_DEV_USER="danyilfiut@gmail.com"

# Seed the fake `demo` project with three reports (never in production).
SEED_DEMO=true

# Attachment root on the host; the runner mounts it read-only.
STORAGE_DIR="./.data/storage"

# ── Reserved for plans 03–04 (declared here so the runner mounts and secrets are known) ──────
# Agent provider auth — decision 2026-09-24: the owner's Claude subscription. Generate once with
# `claude setup-token` on a machine with a browser (one-year OAuth token) and put it here for the
# runner container. ANTHROPIC_API_KEY is the later switch to pay-as-you-go and takes precedence
# inside Claude Code — never set both.
# CLAUDE_CODE_OAUTH_TOKEN=""
# ANTHROPIC_API_KEY=""
# RUNNER_URL="http://localhost:3102"
# RUNNER_TOKEN=""
# MAIL_HOST="" MAIL_PORT=587 MAIL_USER="" MAIL_PASSWORD="" MAIL_FROM="bugbot@magtrans.eu"
