{
  "name": "bugbot",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-project bug-report and idea triage platform for MAGTRANS internal apps",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @bugbot/shared build && pnpm --parallel --filter @bugbot/shared --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @bugbot/api db:migrate",
    "db:seed": "pnpm --filter @bugbot/api db:seed",
    "db:resetdb": "pnpm --filter @bugbot/api db:resetdb"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
