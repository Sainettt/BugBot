{
  "name": "@bugbot/agent-runner",
  "version": "0.1.0",
  "private": true,
  "description": "BugBot agent runner: one git clone per project + agent providers (plan 01 stub; plan 03 fills it)",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
